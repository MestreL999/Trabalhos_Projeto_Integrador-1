#include <stdio.h>

typedef struct Livro{
    
    int codigo;
    char[100] titulo;
    char [100] autor;
    int ano;
    int qtd;
    int disp;
    
    Livro *proximo;
    
}Livro;

typedef struct Lista{
    
    int tamanho;
    
    Livro *primeiro;
    Livro *ultimo;
    
}Lista;

Lista *criar_lista() {
    Lista *lista = malloc(sizeof(Lista));

    if (lista == NULL) {
        return NULL;
    }

    lista->primeiro = NULL;
    lista->ultimo = NULL;
    lista->tamanho = 0;

    return lista;
}

Livro *inserir_fim(Lista *lista, int codigo, char titulo, char autor, int ano, int qtd) {
    if (lista == NULL) {
        return NULL;
    }

    Livro *novo = malloc(sizeof(Livro));

    if (novo == NULL) {
        return NULL;
    }
    

    novo->codigo = codigo;
    novo->titulo = titulo;
    novo->autor = autor;
    novo->ano = ano;
    novo->qtd = qtd;
    novo->disp = qtd;
    novo->proximo = NULL;

    if (lista->tamanho == 0) {
        lista->primeiro = novo;
        lista->ultimo = novo;
    } else {
        lista->ultimo->proximo = novo;
        lista->ultimo = novo;
    }

    lista->tamanho++;

    return novo;
}

