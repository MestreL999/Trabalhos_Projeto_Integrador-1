#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct Livro{
    int codigo;
    char titulo[100];
    char autor[100];
    int ano;
    int qtd;
    int disp;
    struct Livro *proximo;
} Livro;

typedef struct Lista{
    int tamanho;
    Livro *primeiro;
    Livro *ultimo;
} Lista;

Lista *criar_lista() {
    Lista *lista = malloc(sizeof(Lista));
    if (lista == NULL) {
        return NULL;
    }
    lista->primeiro = NULL;
    lista->ultimo = NULL;
    lista->tamanho = 0;
    return lista;
}

Livro *inserir_fim(Lista *lista, int codigo, const char *titulo, const char *autor, int ano, int qtd) {
    if (lista == NULL) {
        return NULL;
    }

    Livro *novo = malloc(sizeof(Livro));
    if (novo == NULL) {
        return NULL;
    }

    novo->codigo = codigo;
    strcpy(novo->titulo, titulo);
    strcpy(novo->autor, autor);
    novo->ano = ano;
    novo->qtd = qtd;
    novo->disp = qtd;
    novo->proximo = NULL;

    if (lista->tamanho == 0) {
        lista->primeiro = novo;
        lista->ultimo = novo;
    } else {
        lista->ultimo->proximo = novo;
        lista->ultimo = novo;
    }

    lista->tamanho++;
    return novo;
}

int main() {
    int continuar;
    Lista *lista = criar_lista();
    
    printf("Bem vindo ao Babilônicos, qual é a função que você deseja?\n");
    do {
        printf("\n1 - Cadastrar livro\n");
        printf("2 - Listar livros\n");
        printf("3 - Buscar livro\n");
        printf("4 - Atualizar informações\n");
        printf("5 - Excluir livro\n");
        printf("6 - Registrar empréstimo\n");
        printf("7 - Registrar devolução\n");
        printf("8 - Ordenar livros\n");
        printf("9 - Salvar\n");

        printf("\nEscolha uma opção: ");
        int op;
        scanf("%d", &op);
        
        switch(op) {
            case 1: {
                int ccc, aaa, qqq;
                char nnn[100];
                char att[100];
                
                printf("\nInsira o código:\n");
                scanf("%d", &ccc);
                printf("\nInsira o ano de publicação:\n");
                scanf("%d", &aaa);
                printf("\nInsira a quantidade:\n");
                scanf("%d", &qqq);
                
                // Limpa o buffer deixado pelo scanf
                while (getchar() != '\n');
                
                printf("\nInsira o título do livro:\n");
                fgets(nnn, sizeof(nnn), stdin);
                nnn[strcspn(nnn, "\n")] = '\0'; // Remove a quebra de linha do final
                
                printf("\nInsira o autor:\n");
                fgets(att, sizeof(att), stdin);
                att[strcspn(att, "\n")] = '\0'; // Remove a quebra de linha do final
                
                inserir_fim(lista, ccc, nnn, att, aaa, qqq);
                printf("\nLivro cadastrado com sucesso!\n");
                break;
            }
            case 2:
            case 3:
            case 4:
            case 5:
            case 6:
            case 7:
            case 8:
            case 9:
                printf("\nFunção em desenvolvimento.\n");
                break;
            default:
                printf("\nOpção inválida.\n");
        }
        
        printf("\nDeseja continuar?\n");
        printf("1 -> Continuar.\n");
        printf("2 -> Encerrar.\n");
        scanf("%d", &continuar);
        
    } while(continuar == 1);

    return 0;
}
