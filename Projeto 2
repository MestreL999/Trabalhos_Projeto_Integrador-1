#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct Livro{
    
    int codigo;
    char titulo[100];
    char autor[100];
    int ano;
    int qtd;
    int disp;
    
    struct Livro *proximo;
    
}Livro;

typedef struct Lista{
    
    int tamanho;
    
    Livro *primeiro;
    Livro *ultimo;
    
}Lista;

Lista *criar_lista() {
    Lista *lista = malloc(sizeof(Lista));

    if (lista == NULL) {
        return NULL;
    }

    lista->primeiro = NULL;
    lista->ultimo = NULL;
    lista->tamanho = 0;

    return lista;
}

// Função auxiliar para buscar livro por título
Livro *buscar_por_titulo(Lista *lista, const char *titulo) {
    if (lista == NULL) return NULL;
    
    Livro *atual = lista->primeiro;
    while (atual != NULL) {
        if (strcmp(atual->titulo, titulo) == 0) {
            return atual;
        }
        atual = atual->proximo;
    }
    return NULL;
}

Livro *inserir_fim(Lista *lista, int codigo, char *titulo, char *autor, int ano, int qtd) {
    if (lista == NULL) {
        return NULL;
    }

    Livro *novo = malloc(sizeof(Livro));

    if (novo == NULL) {
        return NULL;
    }
    
    novo->codigo = codigo;
    strcpy(novo->titulo, titulo);
    strcpy(novo->autor, autor);
    novo->ano = ano;
    novo->qtd = qtd;
    novo->disp = qtd;
    novo->proximo = NULL;

    if (lista->tamanho == 0) {
        lista->primeiro = novo;
        lista->ultimo = novo;
    } else {
        lista->ultimo->proximo = novo;
        lista->ultimo = novo;
    }

    lista->tamanho++;

    return novo;
}

int main()
{
    int continuar;
    
    Lista *lista = criar_lista();
    
    printf("Bem vindo ao Babilônicos, qual é a função que você deseja?\n");
    do{
    printf("\n1 - Cadastrar livro\n");
    printf("\n2 - Listar livros\n");
    printf("\n3 - Buscar livro\n");
    printf("\n4 - Atualizar informações\n");
    printf("\n5 - Excluir livro\n");
    printf("\n6 - Registrar empréstimo\n");
    printf("\n7 - Registrar devolução\n");
    printf("\n8 - Ordenar livros\n");
    printf("\n9 - Salvar\n");

    printf("\nEscolha uma opção:");
    
    int op;
    
    scanf("%d",&op);
    
    switch(op){
        
        case 1:{
            int ccc, aaa, qqq;
            char nnn[100];
            char att[100];
            printf("\nInsira o código:\n");
            scanf("%d",&ccc);
            printf("\nInsira o ano de publicação:\n");
            scanf("%d",&aaa);
            printf("\nInsira a quantidade:\n");
            scanf("%d",&qqq);
            
            while (getchar() != '\n'); // Limpa buffer do teclado
            
            printf("\nInsira o título do livro:\n");
            fgets(nnn,sizeof(nnn),stdin);
            nnn[strcspn(nnn, "\n")] = '\0';
            
            printf("\nInsira o autor:\n");
            fgets(att,sizeof(att),stdin);
            att[strcspn(att, "\n")] = '\0';
            
            inserir_fim(lista, ccc, nnn, att, aaa, qqq);
            
            break;
        }
        
        case 2:{
            break;
        }
        
        case 3:{
            break;
        }
            
        case 4:{
            break;
        }
            
        case 5:{
            break;
        }
        
        case 6:{
            char nome_busca[100];
            
            while (getchar() != '\n'); // Limpa buffer do teclado
            
            printf("\nInsira o título do livro para empréstimo:\n");
            fgets(nome_busca, sizeof(nome_busca), stdin);
            nome_busca[strcspn(nome_busca, "\n")] = '\0';
            
            Livro *alvo = buscar_por_titulo(lista, nome_busca);
            
            if (alvo == NULL) {
                printf("\nLivro não encontrado no sistema!\n");
            } else if (alvo->disp > 0) {
                alvo->disp--;
                printf("\nEmpréstimo realizado com sucesso! Exemplares disponíveis: %d\n", alvo->disp);
            } else {
                printf("\nNão há exemplares disponíveis no momento.\n");
            }
            break;
        }
        
        case 7:{
            char nome_busca[100];
            
            while (getchar() != '\n'); // Limpa buffer do teclado
            
            printf("\nInsira o título do livro para devolução:\n");
            fgets(nome_busca, sizeof(nome_busca), stdin);
            nome_busca[strcspn(nome_busca, "\n")] = '\0';
            
            Livro *alvo = buscar_por_titulo(lista, nome_busca);
            
            if (alvo == NULL) {
                printf("\nLivro não encontrado no sistema!\n");
            } else if (alvo->disp < alvo->qtd) {
                alvo->disp++;
                printf("\nDevolução registrada com sucesso! Exemplares disponíveis: %d\n", alvo->disp);
            } else {
                printf("\nErro: Todos os exemplares já estão na biblioteca.\n");
            }
            break;
        }
            
        case 8:{
            break;
        }
            
        case 9:{
            break;
        }
            
        default:
            printf("\nOpção inválida.\n");
    }
    
    printf("\nDeseja continuar?\n");
    printf("\n1 -> Continuar.\n");
    printf("\n2 -> Encerrar.\n");
    scanf("%d",&continuar);
    
    }while(continuar==1);
    

    return 0;
}
